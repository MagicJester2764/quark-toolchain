--- a/arch/x86_64/crt_arch.h	2024-02-29 21:07:33.000000000 -0500
+++ b/arch/x86_64/crt_arch.h	2026-09-10 16:36:53.842418147 -0400
@@ -1,12 +1,16 @@
+/* Quark starts a task at its entry point with a stack and nothing on it. The
+ * arguments arrive on a page the spawner mapped, so the argc/argv/environment/
+ * auxv block that `_start_c` reads has to be built rather than pointed at.
+ * `__quark_start_args` builds it and returns it.
+ */
 __asm__(
 ".text \n"
 ".global " START " \n"
 START ": \n"
 "	xor %rbp,%rbp \n"
-"	mov %rsp,%rdi \n"
-".weak _DYNAMIC \n"
-".hidden _DYNAMIC \n"
-"	lea _DYNAMIC(%rip),%rsi \n"
 "	andq $-16,%rsp \n"
+"	call __quark_start_args \n"
+"	mov %rax,%rdi \n"
+"	xor %esi,%esi \n"
 "	call " START "_c \n"
 );
