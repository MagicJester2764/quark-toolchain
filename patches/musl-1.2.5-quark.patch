--- a/src/thread/x86_64/clone.s	2024-02-29 21:07:33.000000000 -0500
+++ b/src/thread/x86_64/clone.s	2026-09-10 16:36:53.843289883 -0400
@@ -1,28 +1,13 @@
+/* Linux's clone has the child return from this very system call on a new
+ * stack. Quark starts a task at an entry point and cannot resume something
+ * that never ran, so the whole of it is done in the translation layer.
+ *
+ * A tail call and nothing else: __clone's seven arguments are already in the
+ * registers a C function of the same shape expects.
+ */
 .text
 .global __clone
 .hidden __clone
 .type   __clone,@function
 __clone:
-	xor %eax,%eax
-	mov $56,%al
-	mov %rdi,%r11
-	mov %rdx,%rdi
-	mov %r8,%rdx
-	mov %r9,%r8
-	mov 8(%rsp),%r10
-	mov %r11,%r9
-	and $-16,%rsi
-	sub $8,%rsi
-	mov %rcx,(%rsi)
-	syscall
-	test %eax,%eax
-	jnz 1f
-	xor %ebp,%ebp
-	pop %rdi
-	call *%r9
-	mov %eax,%edi
-	xor %eax,%eax
-	mov $60,%al
-	syscall
-	hlt
-1:	ret
+	jmp __quark_clone
